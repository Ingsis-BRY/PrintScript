' ============================================================
'  PrintScript
'  Diagrama 1: componentes (modulos y dependencias)
'  Diagrama 2: clases
' ============================================================

@startuml componentes
title PrintScript — Componentes (11 modulos Gradle)

package "PrintScript" {
    [common]      <<modulo>>
    [token]       <<modulo>>
    [ast]         <<modulo>>
    [report]      <<modulo>>
    [language]    <<modulo>>
    [lexer]       <<modulo>>
    [parser]      <<modulo>>
    [interpreter] <<modulo>>
    [pipeline]    <<modulo>>
    [cli]         <<modulo>>
    [app]         <<modulo>>
}

note right of [common]
  Position, Span, Located.
  Donde esta algo en el fuente.
  Modulo hoja: no depende de nadie.
end note

note right of [report]
  Result<T> y el catalogo de errores
  (Diagnostic, ADT sellado) + ErrorRenderer.
  Result y Diagnostic viven juntos porque
  Failure(error: Diagnostic) es un solo tipo.
end note

note right of [language]
  Que significa "number" en PrintScript
  y que devuelve cada operador.
  Unica fuente de verdad.
end note

note right of [pipeline]
  Entrega un statement por vez.
  Declara TokenSource y StatementParser,
  asi que NO depende de lexer ni de parser:
  las interfaces viven en el consumidor.
end note

note right of [cli]
  Cli declara Program y conduce una corrida a traves
  de Program y StatementStream. No depende de lexer,
  parser ni interpreter: no los tiene en el classpath.
end note

note right of [app]
  El composition root, en su propio modulo.
  Es el unico que depende de :lexer, :parser e
  :interpreter, asi que la regla la hace cumplir
  Gradle y no la convencion.
end note

[token]       --> [common]
[ast]         --> [common]

[report]      --> [common]
[report]      --> [ast]

[language]    --> [common]
[language]    --> [ast]
[language]    --> [report]

[lexer]       --> [common]
[lexer]       --> [token]
[lexer]       --> [report]

[parser]      --> [common]
[parser]      --> [token]
[parser]      --> [ast]
[parser]      --> [language]
[parser]      --> [report]

[interpreter] --> [common]
[interpreter] --> [ast]
[interpreter] --> [language]
[interpreter] --> [report]

[pipeline]    --> [token]
[pipeline]    --> [ast]
[pipeline]    --> [report]

[cli]         --> [common]
[cli]         --> [ast]
[cli]         --> [pipeline]
[cli]         --> [report]

' el unico modulo que nombra implementaciones concretas
[app]         --> [cli]
[app]         --> [pipeline]
[app]         --> [report]
[app]         --> [lexer]
[app]         --> [parser]
[app]         --> [interpreter]

@enduml


@startuml clases
title PrintScript — Clases

' ------------------------------------------------------------
package common {

    class Position {
        +line: Int
        +column: Int
    }

    class Span {
        +start: Position
        +end: Position
        +at(position: Position): Span
    }

    interface Located {
        +start: Position
        +end: Position
        +span: Span
    }

    Span *--> Position
    Located ..> Span : expone
}

' ------------------------------------------------------------
package report {

    interface Result<T> <<sealed>>

    class Success<T> implements Result {
        +value: T
    }

    class Failure implements Result {
        +error: Diagnostic
    }

    note right of Result
      map / flatMap / fold
      son funciones de extension
    end note

    interface Diagnostic <<sealed>> {
        +span: Span
    }

    class UnexpectedCharacter implements Diagnostic {
        +character: Char
    }
    class MalformedLexeme implements Diagnostic {
        +fault: LexicalFault
    }
    class SourceUnreadable implements Diagnostic {
        +detail: String
    }

    class ExpectedSymbol implements Diagnostic {
        +expected: SyntaxSymbol
    }
    class UnexpectedToken implements Diagnostic {
        +lexeme: String
    }
    class UnexpectedEndOfInput implements Diagnostic {
        +unit: SyntacticUnit
    }
    class UnknownType implements Diagnostic {
        +name: String
    }
    class MalformedNumber implements Diagnostic {
        +text: String
    }

    class VariableAlreadyDeclared implements Diagnostic {
        +name: String
    }
    class VariableNotDeclared implements Diagnostic {
        +name: String
    }
    class VariableWithoutValue implements Diagnostic {
        +name: String
    }
    class IncompatibleAssignment implements Diagnostic {
        +declared: Type
        +actual: Type
    }
    class IncompatibleOperands implements Diagnostic {
        +operator: BinaryOperator
        +left: Type
        +right: Type
    }
    class UnknownFunction implements Diagnostic {
        +name: String
    }
    class DivisionByZero implements Diagnostic

    enum LexicalFault {
        UNTERMINATED_STRING
    }
    enum SyntaxSymbol {
        LET
        IDENTIFIER
        COLON
        TYPE_NAME
        ASSIGN
        SEMICOLON
        LEFT_PAREN
        RIGHT_PAREN
        PRINTLN
    }
    enum SyntacticUnit {
        EXPRESSION
        STATEMENT
    }

    class ErrorRenderer {
        +render(error: Diagnostic): String
    }

    Diagnostic *--> Span
    Failure o--> Diagnostic
}

' ------------------------------------------------------------
package token {

    interface Token <<sealed>> {
        +lexeme: String
    }
    Token --|> Located

    class LetToken implements Token
    class IdentifierToken implements Token {
        +name: String
    }
    class TypeNameToken implements Token {
        +name: String
    }
    class NumberLiteralToken implements Token {
        +text: String
    }
    class StringLiteralToken implements Token {
        +value: String
    }
    class AssignToken implements Token
    class ColonToken implements Token
    class SemicolonToken implements Token
    class PlusToken implements Token
    class MinusToken implements Token
    class StarToken implements Token
    class SlashToken implements Token
    class LeftParenToken implements Token
    class RightParenToken implements Token
}

' ------------------------------------------------------------
package ast {

    interface Statement <<sealed>>
    interface Expression <<sealed>>
    Statement --|> Located
    Expression --|> Located

    class VariableDeclaration implements Statement {
        +name: String
        +declaredType: Type
        +initializer: Expression?
    }
    class Assignment implements Statement {
        +name: String
        +value: Expression
    }
    class CallStatement implements Statement {
        +callee: String
        +argument: Expression
    }

    class NumberLiteral implements Expression {
        +value: Double
    }
    class StringLiteral implements Expression {
        +value: String
    }
    class VariableReference implements Expression {
        +name: String
    }
    class BinaryExpression implements Expression {
        +left: Expression
        +operator: BinaryOperator
        +right: Expression
    }

    interface BinaryOperator <<sealed>>
    class Addition       implements BinaryOperator
    class Subtraction    implements BinaryOperator
    class Multiplication implements BinaryOperator
    class Division       implements BinaryOperator

    interface Type <<sealed>>
    class NumberType implements Type
    class StringType implements Type
}

' ------------------------------------------------------------
package language {

    class NumberCodec <<object>> {
        +parse(text: String, span: Span): Result<Double>
        +render(value: Double): String
    }

    class OperatorRules <<object>> {
        +resultType(op: BinaryOperator, left: Type, right: Type): Type?
    }

    note bottom of OperatorRules
      devuelve null, no un error:
      no tiene posicion que culpar
    end note
}

' ------------------------------------------------------------
package lexer {

    interface SourceReader {
        +peek(): SourceChar
        +peekNext(): SourceChar
        +next(): SourceChar
        +hasNext(): Boolean
    }

    class StreamSourceReader implements SourceReader
    class StringSourceReader implements SourceReader

    interface SourceChar <<sealed>>
    class Character implements SourceChar {
        +value: Char
    }
    class EndOfSource implements SourceChar
    class Failed implements SourceChar {
        +message: String
    }

    class Lexer {
        -reader: SourceReader
        -recognizers: List<TokenRecognizer>
        +tokens(): Sequence<Result<Token>>
    }

    interface TokenRecognizer {
        +recognize(lexeme: String): RecognizerState
        +tokenOf(lexeme: String, start: Position, end: Position): Token
        +diagnose(lexeme: String): LexicalFault?
    }

    class FixedLexemeRecognizer implements TokenRecognizer
    class IdentifierRecognizer <<object>> implements TokenRecognizer
    class NumberLiteralRecognizer <<object>> implements TokenRecognizer
    class StringLiteralRecognizer <<object>> implements TokenRecognizer

    interface RecognizerState <<sealed>>

    class TokenRecognizers <<object>> {
        +DEFAULT: List<TokenRecognizer>
    }

    note bottom of Lexer
      maximal munch: gana el lexema mas largo;
      si empatan, el orden de TokenRecognizers.DEFAULT
    end note
}

' ------------------------------------------------------------
package parser {

    class Parser <<object>> {
        +parse(tokens: List<Token>): Result<Statement>
        +parseExpression(tokens: List<Token>): Result<Expression>
    }

    class TokenCursor {
        -tokens: List<Token>
        -index: Int
        +peek(): Token?
        +consume(): Token?
        +hasNext(): Boolean
    }

    class PrecedenceTable <<object>> {
        +precedenceOf(token: Token): Int
    }
}

' ------------------------------------------------------------
package interpreter {

    class Interpreter {
        -environment: Environment
        -output: OutputEmitter
        -valueOps: ValueOps
        +execute(statement: Statement): Result<Unit>
    }

    class Environment {
        -slots: MutableMap<String, Slot>
        +declare(name: String, type: Type, span: Span): Result<Unit>
        +initialize(name: String, value: Value, span: Span): Result<Unit>
        +assign(name: String, value: Value, span: Span): Result<Unit>
        +lookup(name: String, span: Span): Result<Value>
    }

    interface Slot <<sealed>>
    class Declared implements Slot {
        +type: Type
    }
    class Bound implements Slot {
        +value: Value
    }

    interface Value <<sealed>> {
        +type: Type
    }
    class NumberValue implements Value {
        +value: Double
    }
    class StringValue implements Value {
        +value: String
    }

    class ValueOps {
        +apply(op: BinaryOperator, left: Value, right: Value, span: Span): Result<Value>
    }

    interface OutputEmitter {
        +emit(line: String)
    }
    class ConsoleOutput implements OutputEmitter
    class CollectingOutput implements OutputEmitter {
        +lines(): List<String>
    }
}

' ------------------------------------------------------------
package pipeline {

    interface TokenSource <<fun>> {
        +tokens(): Sequence<Result<Token>>
    }

    interface StatementParser <<fun>> {
        +parse(tokens: List<Token>): Result<Statement>
    }

    class StatementStream {
        -tokens: Iterator<Result<Token>>
        -parser: StatementParser
        +hasNext(): Boolean
        +next(): Result<Statement>
    }

    StatementStream --> TokenSource
    StatementStream --> StatementParser

    note bottom of TokenSource
      declaradas por el consumidor.
      pipeline no depende de lexer ni de parser
    end note
}

' ------------------------------------------------------------
package cli {

    enum Operation {
        VALIDATION
        EXECUTION
    }

    interface Program <<fun>> {
        +execute(statement: Statement): Result<Unit>
    }

    class Cli {
        -newStream: (Reader) -> StatementStream
        -newProgram: () -> Program
        -renderer: ErrorRenderer
        -progress: ProgressPrinter
        -errors: Appendable
        +run(operation: Operation, file: Path, version: String?): Result<Unit>
    }

    Cli --> Program

    class ProgressPrinter {
        -sink: Appendable
        +statementParsed(position: Position)
    }

}

' ------------------------------------------------------------
package app {

    class Main <<composition root>> {
        +main(args: Array<String>)
    }

    note bottom of Main
      Pure DI: arma el grafo a mano y es el unico
      que nombra clases concretas. Lo que depende de
      un valor de runtime entra como factory:
      el stream (necesita el Reader, es de un solo uso)
      y el Program (estado vacio por corrida).
      Satisface TokenSource, StatementParser y Program
      con referencias a metodo, sin clases adaptadoras.
    end note
}

' ------------------------------------------------------------
' Relaciones entre paquetes
' ------------------------------------------------------------

Lexer *--> SourceReader
Lexer o--> TokenRecognizer
Lexer ..> Token : construye
TokenRecognizers ..> TokenRecognizer : lista por prioridad

Parser ..> Token : consume
Parser *--> TokenCursor
Parser ..> PrecedenceTable
Parser ..> NumberCodec : convierte literales
Parser ..> Statement : construye

VariableDeclaration o--> Type
VariableDeclaration o--> Expression
Assignment o--> Expression
CallStatement o--> Expression
BinaryExpression o--> BinaryOperator

OperatorRules ..> Type

Lexer ..|> TokenSource : via Main
Parser ..|> StatementParser : via Main
Interpreter ..|> Program : via Main

Interpreter *--> Environment
Interpreter *--> ValueOps
Interpreter --> OutputEmitter
Interpreter ..> Statement : ejecuta
Environment o--> Slot
Slot o--> Value
ValueOps ..> OperatorRules
ValueOps ..> NumberCodec : imprime numeros

Cli ..> StatementStream : consume
Cli --> ErrorRenderer
Cli *--> ProgressPrinter

Main ..> Cli : construye
Main ..> Lexer : construye
Main ..> StatementStream : construye
Main ..> Interpreter : construye
Main ..> ConsoleOutput : construye
Main ..> TokenSource : Lexer::tokens
Main ..> StatementParser : Parser::parse
Main ..> Program : Interpreter::execute

Lexer ..> Result : devuelve
Parser ..> Result : devuelve
Interpreter ..> Result : devuelve
Result ..> Diagnostic
ErrorRenderer ..> Diagnostic : abre el ADT

@enduml
