' ============================================================
'  PrintScript
'  Diagrama 1: componentes (módulos y dependencias)
'  Diagrama 2: clases
' ============================================================

@startuml componentes
title PrintScript — Componentes (primera entrega)

package "PrintScript" {
    [common]      <<módulo>>
    [token]       <<módulo>>
    [ast]         <<módulo>>
    [language]    <<módulo>>
    [lexer]       <<módulo>>
    [parser]      <<módulo>>
    [interpreter] <<módulo>>
    [pipeline]    <<módulo>>
    [cli]         <<módulo>>
}

note right of [common]
  Position, Result<T>,
  catálogo de errores (ADT),
  ErrorRenderer
end note

note right of [language]
  Qué significa "number" en PrintScript
  y qué devuelve cada operador.
  Única fuente de verdad.
end note

note right of [pipeline]
  Compone lexer + parser y entrega
  un statement por vez.
  Lo consumen todas las operaciones.
end note

[token]       --> [common]
[ast]         --> [common]
[language]    --> [common]
[language]    --> [ast]

[lexer]       --> [token]
[lexer]       --> [common]

[parser]      --> [token]
[parser]      --> [ast]
[parser]      --> [language]
[parser]      --> [common]

[interpreter] --> [ast]
[interpreter] --> [language]
[interpreter] --> [common]

[pipeline]    --> [lexer]
[pipeline]    --> [parser]
[pipeline]    --> [common]

[cli]         --> [pipeline]
[cli]         --> [interpreter]
[cli]         --> [common]

@enduml


@startuml clases
title PrintScript — Clases (primera entrega)

' ------------------------------------------------------------
package common {

    class Position {
        +line: Int
        +column: Int
    }

    interface Result<T> <<sealed>>

    class Success<T> implements Result {
        +value: T
    }

    class Failure<T> implements Result {
        +error: PrintScriptError
    }

    interface PrintScriptError <<sealed>> {
        +start: Position
        +end: Position
    }

    interface LexicalError <<sealed>> extends PrintScriptError
    class UnexpectedCharacter implements LexicalError {
        +character: Char
    }
    class UnterminatedString implements LexicalError

    interface SyntaxError <<sealed>> extends PrintScriptError
    class UnexpectedToken implements SyntaxError {
        +found: String
        +expected: String
    }
    class MissingSemicolon implements SyntaxError
    class MalformedNumber implements SyntaxError {
        +lexeme: String
    }

    interface RuntimeError <<sealed>> extends PrintScriptError
    class UndeclaredVariable implements RuntimeError {
        +name: String
    }
    class UninitializedVariable implements RuntimeError {
        +name: String
    }
    class DuplicateDeclaration implements RuntimeError {
        +name: String
    }
    class TypeMismatch implements RuntimeError {
        +expected: String
        +actual: String
    }
    class DivisionByZero implements RuntimeError

    class ErrorRenderer {
        +render(error: PrintScriptError): String
    }
}

' ------------------------------------------------------------
package token {

    interface Token <<sealed>> {
        +lexeme: String
        +start: Position
        +end: Position
    }

    class LetToken implements Token
    class IdentifierToken implements Token {
        +name: String
    }
    class TypeNameToken implements Token {
        +name: String
    }
    class NumberLiteralToken implements Token {
        +text: String
    }
    class StringLiteralToken implements Token {
        +value: String
    }
    class AssignToken implements Token
    class ColonToken implements Token
    class SemicolonToken implements Token
    class PlusToken implements Token
    class MinusToken implements Token
    class StarToken implements Token
    class SlashToken implements Token
    class LeftParenToken implements Token
    class RightParenToken implements Token
}

' ------------------------------------------------------------
package ast {

    interface Node <<sealed>> {
        +start: Position
        +end: Position
    }

    interface Statement <<sealed>> extends Node
    interface Expression <<sealed>> extends Node

    class VariableDeclaration implements Statement {
        +name: String
        +declaredType: Type
        +initializer: Expression
    }
    class Assignment implements Statement {
        +name: String
        +value: Expression
    }
    class CallStatement implements Statement {
        +callee: String
        +argument: Expression
    }

    class NumberLiteral implements Expression {
        +value: Double
    }
    class StringLiteral implements Expression {
        +value: String
    }
    class VariableReference implements Expression {
        +name: String
    }
    class BinaryExpression implements Expression {
        +left: Expression
        +operator: BinaryOperator
        +right: Expression
    }

    interface BinaryOperator <<sealed>>
    class Addition       implements BinaryOperator
    class Subtraction    implements BinaryOperator
    class Multiplication implements BinaryOperator
    class Division       implements BinaryOperator

    interface Type <<sealed>>
    class NumberType implements Type
    class StringType implements Type
}

' ------------------------------------------------------------
package language {

    class NumberCodec {
        +parse(text: String): Result<Double>
        +render(value: Double): String
    }

    class OperatorRules {
        +resultType(op: BinaryOperator, left: Type, right: Type): Result<Type>
    }
}

' ------------------------------------------------------------
package lexer {

    interface SourceReader {
        +peek(): Char
        +next(): Char
        +hasNext(): Boolean
    }

    class StreamSourceReader implements SourceReader

    class StatementLexer {
        -reader: SourceReader
        -line: Int
        -column: Int

        +hasNext(): Boolean
        +next(): Result<List<Token>>

        -readToken(): Result<Token>
        -readNumber(): Result<Token>
        -readIdentifierOrKeyword(): Result<Token>
        -readString(): Result<Token>
        -readSymbol(): Result<Token>
        -skipWhitespace()
    }
}

' ------------------------------------------------------------
package parser {

    class Parser {
        -numbers: NumberCodec
        -precedences: PrecedenceTable

        +parse(tokens: List<Token>): Result<Statement>

        -parseDeclaration(cursor: TokenCursor): Result<Statement>
        -parseAssignment(cursor: TokenCursor): Result<Statement>
        -parseCall(cursor: TokenCursor): Result<Statement>
        -parseExpression(cursor: TokenCursor, precedence: Int): Result<Expression>
        -parsePrefix(cursor: TokenCursor): Result<Expression>
        -parseInfix(cursor: TokenCursor, left: Expression): Result<Expression>
    }

    class TokenCursor {
        -tokens: List<Token>
        -index: Int

        +peek(): Token
        +consume(): Token
        +hasNext(): Boolean
    }

    class PrecedenceTable {
        +precedenceOf(token: Token): Int
    }
}

' ------------------------------------------------------------
package interpreter {

    class Interpreter {
        -environment: Environment
        -output: OutputEmitter
        -operations: ValueOps
        -numbers: NumberCodec

        +execute(statement: Statement): Result<Unit>
        -evaluate(expression: Expression): Result<Value>
    }

    class Environment {
        -slots: MutableMap<String, Slot>

        +declare(name: String, type: Type): Result<Unit>
        +initialize(name: String, value: Value): Result<Unit>
        +assign(name: String, value: Value): Result<Unit>
        +lookup(name: String): Result<Value>
    }

    interface Slot <<sealed>>
    class Declared implements Slot {
        +type: Type
    }
    class Bound implements Slot {
        +value: Value
    }

    interface Value <<sealed>>
    class NumberValue implements Value {
        +value: Double
    }
    class StringValue implements Value {
        +value: String
    }

    class ValueOps {
        -rules: OperatorRules
        +apply(op: BinaryOperator, left: Value, right: Value): Result<Value>
    }

    interface OutputEmitter {
        +emit(line: String)
    }
    class ConsoleOutput implements OutputEmitter
    class CollectingOutput implements OutputEmitter {
        +lines(): List<String>
    }
}

' ------------------------------------------------------------
package pipeline {

    class StatementStream {
        -lexer: StatementLexer
        -parser: Parser

        +hasNext(): Boolean
        +next(): Result<Statement>
    }
}

' ------------------------------------------------------------
package cli {

    enum Operation {
        VALIDATION
        EXECUTION
    }

    class Cli {
        +run(operation: Operation, file: Path, version: String)
        -execute(stream: StatementStream)
        -validate(stream: StatementStream)
        -report(error: PrintScriptError)
    }

    class ProgressPrinter {
        +statementParsed(position: Position)
    }
}

' ------------------------------------------------------------
' Relaciones
' ------------------------------------------------------------

StatementLexer *--> SourceReader
StatementLexer ..> Token : construye
Token *--> Position

Parser ..> Token : consume
Parser *--> TokenCursor
Parser *--> PrecedenceTable
Parser --> NumberCodec : convierte literales
Parser ..> Statement : construye
Node *--> Position

VariableDeclaration o--> Type
VariableDeclaration o--> Expression
Assignment o--> Expression
CallStatement o--> Expression
BinaryExpression o--> BinaryOperator

OperatorRules ..> Type

StatementStream *--> StatementLexer
StatementStream *--> Parser

Interpreter *--> Environment
Interpreter *--> ValueOps
Interpreter --> OutputEmitter
Interpreter --> NumberCodec : imprime números
Interpreter ..> Statement : ejecuta
Environment o--> Slot
Slot o--> Value
ValueOps --> OperatorRules

Cli --> StatementStream : consume
Cli --> Interpreter
Cli --> ErrorRenderer
Cli *--> ProgressPrinter

StatementLexer ..> Result : devuelve
Parser ..> Result : devuelve
Interpreter ..> Result : devuelve
Result ..> PrintScriptError
ErrorRenderer ..> PrintScriptError : abre el ADT

@enduml