[lexer]       --> [token]
[lexer]       --> [report]

[parser]      --> [common]
[parser]      --> [token]
[parser]      --> [ast]
[parser]      --> [language]
[parser]      --> [report]

[interpreter] --> [common]
[interpreter] --> [ast]
[interpreter] --> [language]
[interpreter] --> [report]

[pipeline]    --> [token]
[pipeline]    --> [ast]
[pipeline]    --> [report]

