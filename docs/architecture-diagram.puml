@startuml clases
title PrintScript — Clases

' ------------------------------------------------------------
package common {

    class Position {
        +line: Int
        +column: Int
    }

    class Span {
        +start: Position
        +end: Position
        +at(position: Position): Span
    }

    interface Located {
        +start: Position
        +end: Position
        +span: Span
    }

    Span *--> Position
    Located ..> Span : expone
}

' ------------------------------------------------------------
package report {

    interface Result<T> <<sealed>>

    class Success<T> implements Result {
        +value: T
    }

    class Failure implements Result {
        +error: Diagnostic
    }

    note right of Result
      map / flatMap / fold
      son funciones de extension
    end note

    interface Diagnostic <<sealed>> {
        +span: Span
    }

    class UnexpectedCharacter implements Diagnostic {
        +character: Char
    }
    class MalformedLexeme implements Diagnostic {
        +fault: LexicalFault
    }
    class SourceUnreadable implements Diagnostic {
        +detail: String
    }

    class ExpectedSymbol implements Diagnostic {
        +expected: SyntaxSymbol
    }
    class UnexpectedToken implements Diagnostic {
        +lexeme: String
    }
    class UnexpectedEndOfInput implements Diagnostic {
        +unit: SyntacticUnit
    }
    class UnknownType implements Diagnostic {
        +name: String
    }
    class MalformedNumber implements Diagnostic {
        +text: String
    }

    class VariableAlreadyDeclared implements Diagnostic {
        +name: String
    }
    class VariableNotDeclared implements Diagnostic {
        +name: String
    }
    class VariableWithoutValue implements Diagnostic {
        +name: String
    }
    class IncompatibleAssignment implements Diagnostic {
        +declared: Type
        +actual: Type
    }
    class IncompatibleOperands implements Diagnostic {
        +operator: BinaryOperator
        +left: Type
        +right: Type
    }
    class UnknownFunction implements Diagnostic {
        +name: String
    }
    class DivisionByZero implements Diagnostic
    class UnsupportedStatement implements Diagnostic

    ' agregados en 1.1
    class NonBooleanCondition implements Diagnostic {
        +actual: Type
    }
    class NonVariableCondition implements Diagnostic
    class ConstantReassignment implements Diagnostic {
        +name: String
    }
    class UninterpretableInput implements Diagnostic {
        +text: String
        +expected: Type
    }
    class IncompatibleArgument implements Diagnostic {
        +name: String
        +expected: Type
        +actual: Type
    }
    class MissingInput implements Diagnostic
    class MissingEnvironmentVariable implements Diagnostic {
        +name: String
    }

    enum LexicalFault {
        UNTERMINATED_STRING
    }
    enum SyntaxSymbol {
        LET
        CONST
        IF
        LEFT_BRACE
        RIGHT_BRACE
        IDENTIFIER
        COLON
        TYPE_NAME
        ASSIGN
        SEMICOLON
        LEFT_PAREN
        RIGHT_PAREN
        PRINTLN
    }
    enum SyntacticUnit {
        EXPRESSION
        STATEMENT
    }

    class ErrorRenderer {
        +render(error: Diagnostic): String
    }

    Diagnostic *--> Span
    Failure o--> Diagnostic
}

' ------------------------------------------------------------
package token {

    interface Token <<sealed>> {
        +lexeme: String
    }
    Token --|> Located

    class LetToken implements Token
    class IdentifierToken implements Token {
        +name: String
    }
    class TypeNameToken implements Token {
        +name: String
    }
    class NumberLiteralToken implements Token {
        +text: String
    }
    class StringLiteralToken implements Token {
        +value: String
    }
    class AssignToken implements Token
    class ColonToken implements Token
    class SemicolonToken implements Token
    class PlusToken implements Token
    class MinusToken implements Token
    class StarToken implements Token
    class SlashToken implements Token
    class LeftParenToken implements Token
    class RightParenToken implements Token

    ' agregados en 1.1
    class ConstToken implements Token
    class IfToken implements Token
    class ElseToken implements Token
    class BooleanLiteralToken implements Token {
        +value: Boolean
    }
    class LeftBraceToken implements Token
    class RightBraceToken implements Token
}

' ------------------------------------------------------------
package ast {

    interface Statement <<sealed>>
    interface Expression <<sealed>>
    Statement --|> Located
    Expression --|> Located

    class VariableDeclaration implements Statement {
        +name: String
        +declaredType: Type
        +initializer: Expression?
        +mutable: Boolean
    }

    note right of VariableDeclaration
      `mutable` es lo unico que distingue un
      `let` de un `const`: la palabra ya no
      existe cuando el statement si, y la
      reasignacion que hay que rechazar pasa
      mas tarde y en otro lado
    end note
    class Assignment implements Statement {
        +name: String
        +value: Expression
    }
    class CallStatement implements Statement {
        +callee: String
        +argument: Expression
    }

    class IfStatement implements Statement {
        +condition: Expression
        +consequence: List<Statement>
        +alternative: List<Statement>?
    }

    class NumberLiteral implements Expression {
        +value: Double
    }
    class StringLiteral implements Expression {
        +value: String
    }
    class VariableReference implements Expression {
        +name: String
    }
    class BinaryExpression implements Expression {
        +left: Expression
        +operator: BinaryOperator
        +right: Expression
    }

    class BooleanLiteral implements Expression {
        +value: Boolean
    }

    class FunctionCall implements Expression {
        +callee: String
        +argument: Expression
    }

    note right of FunctionCall
      una llamada que **da un valor**
      (readInput, readEnv), a diferencia de
      CallStatement, que se hace por su efecto
    end note

    interface BinaryOperator <<sealed>>
    class Addition       implements BinaryOperator
    class Subtraction    implements BinaryOperator
    class Multiplication implements BinaryOperator
    class Division       implements BinaryOperator

    interface Type <<sealed>>
    class NumberType implements Type
    class StringType implements Type
    class BooleanType implements Type
}

' ------------------------------------------------------------
package language {

    class NumberCodec <<object>> {
        +parse(text: String, span: Span): Result<Double>
        +render(value: Double): String
    }

    class OperatorRules <<object>> {
        +resultType(op: BinaryOperator, left: Type, right: Type): Type?
    }

    note bottom of OperatorRules
      devuelve null, no un error:
      no tiene posicion que culpar
    end note

    class Environment<V> {
        -parent: Environment<V>?
        -slots: MutableMap<String, Slot<V>>
        +child(): Environment<V>
        +declare(name, type, mutable, span): Result<Unit>
        +initialize(name, value: V, type, span): Result<Unit>
        +assign(name, value: V, type, span): Result<Unit>
        +lookup(name, span): Result<V>
        +typeOf(name, span): Result<Type>
        +declaredTypeOf(name): Type?
    }

    interface Slot<V> <<sealed>>
    class Declared implements Slot {
        +type: Type
        +mutable: Boolean
    }
    class Bound<V> implements Slot {
        +value: V
    }

    Environment o--> Slot

    note bottom of Environment
      el store de variables y sus reglas de
      alcance, compartido: el interprete lo
      instancia con Value, el checker con Unit.
      el tipo se pasa en cada bind en vez de
      leerse del V, porque un store que sepa
      tipar su contenido no podria guardar Unit
    end note
}

' ------------------------------------------------------------
package lexer {

    interface SourceReader {
        +peek(): SourceChar
        +peekNext(): SourceChar
        +next(): SourceChar
        +hasNext(): Boolean
    }

    class StreamSourceReader implements SourceReader
    class StringSourceReader implements SourceReader

    interface SourceChar <<sealed>>
    class Character implements SourceChar {
        +value: Char
    }
    class EndOfSource implements SourceChar
    class Failed implements SourceChar {
        +message: String
    }

    class Lexer {
        -reader: SourceReader
        -recognizers: List<TokenRecognizer>
        +tokens(): Sequence<Result<Token>>
    }

    interface TokenRecognizer {
        +recognize(lexeme: String): RecognizerState
        +tokenOf(lexeme: String, start: Position, end: Position): Token
        +diagnose(lexeme: String): LexicalFault?
    }

    class FixedLexemeRecognizer implements TokenRecognizer
    class IdentifierRecognizer <<object>> implements TokenRecognizer
    class NumberLiteralRecognizer <<object>> implements TokenRecognizer
    class StringLiteralRecognizer <<object>> implements TokenRecognizer

    interface RecognizerState <<sealed>>

    class TokenRecognizers <<object>> {
        +V1_0: List<TokenRecognizer>
        +V1_1: List<TokenRecognizer>
    }

    note bottom of Lexer
      maximal munch: gana el lexema mas largo;
      si empatan, el orden del catalogo.
      **Un catalogo por version**: V1_0 no tiene
      recognizer para const, if, else, boolean,
      true/false ni llaves, asi que esas palabras
      salen como identificadores y el parser las
      rechaza donde esperaba un statement
    end note
}

' ------------------------------------------------------------
package parser {

    class Parser {
        -syntaxes: List<StatementSyntax>
        -parselets: List<PrefixParselet>
        +parse(tokens: List<Token>): Result<Statement>
    }

    interface StatementSyntax {
        +matches(token: Token): Boolean
        +parse(context: ParsingContext): Result<Statement>
    }

    interface ParsingContext {
        +cursor: TokenCursor
        +parseExpression(): Result<Expression>
        +parseStatement(): Result<Statement>
    }

    note right of ParsingContext
      parseStatement es lo que deja que un bloque
      tenga statements sin que IfSyntax nombre al
      despachador que construye el catalogo
      donde vive
    end note

    class VariableDeclarationSyntax implements StatementSyntax
    class AssignmentSyntax <<object>> implements StatementSyntax
    class CallSyntax implements StatementSyntax
    class IfSyntax <<object>> implements StatementSyntax

    class StatementSyntaxes <<object>> {
        +V1_0: List<StatementSyntax>
        +V1_1: List<StatementSyntax>
    }

    ' el tercer registro: que puede *abrir* una expresion
    interface PrefixParselet {
        +matches(token: Token): Boolean
        +parse(token: Token, context: ExpressionContext): Result<Expression>
    }

    interface ExpressionContext {
        +cursor: TokenCursor
        +parseExpression(): Result<Expression>
    }

    class NumberLiteralParselet <<object>> implements PrefixParselet
    class StringLiteralParselet <<object>> implements PrefixParselet
    class BooleanLiteralParselet <<object>> implements PrefixParselet
    class VariableReferenceParselet <<object>> implements PrefixParselet
    class GroupParselet <<object>> implements PrefixParselet
    class FunctionCallParselet implements PrefixParselet

    class PrefixParselets <<object>> {
        +V1_0: List<PrefixParselet>
        +V1_1: List<PrefixParselet>
    }

    note bottom of PrefixParselets
      los operadores infijos **no** son parselets:
      su precedencia es una tabla que un solo loop
      lee, asi que no hay comportamiento por
      operador que registrar. lo que si crece con
      el lenguaje es que puede abrir una expresion
    end note

    note bottom of IfSyntax
      la condicion tiene que ser una
      VariableReference, como pide la consigna;
      cualquier otra cosa da NonVariableCondition
    end note

    class StatementParser {
        -syntaxes: List<StatementSyntax>
        +parse(): Result<Statement>
    }

    class ExpressionParser

    note bottom of StatementSyntaxes
      mismo desempate que el lexer: si dos sintaxis
      reclaman el mismo token, gana la primera de la lista
    end note

    class TokenCursor {
        -tokens: List<Token>
        -index: Int
        +peek(): Token?
        +consume(): Token?
        +hasNext(): Boolean
    }

    class PrecedenceTable <<object>> {
        +precedenceOf(token: Token): Int
    }
}

' ------------------------------------------------------------
package interpreter {

    class Interpreter {
        -globalScope: Environment<Value>
        -output: OutputEmitter
        -valueOps: ValueOps
        -executors: List<StatementExecutor>
        -functions: Map<String, ValueFunction>
        +execute(statement: Statement): Result<Unit>
    }

    note bottom of Interpreter
      el scope viaja como argumento, no como
      campo: cada bloque recibe su propio Context,
      asi no hay nada que restaurar y un fallo no
      puede dejar el scope equivocado puesto
    end note

    interface StatementExecutor {
        +matches(statement: Statement): Boolean
        +execute(statement: Statement, context: ExecutionContext): Result<Unit>
    }

    interface ExecutionContext {
        +environment: Environment<Value>
        +evaluate(expression: Expression, expected: Type?): Result<Value>
        +executeBlock(statements: List<Statement>): Result<Unit>
        +emit(line: String)
    }

    note right of ExecutionContext
      `expected` es el tipo que el resultado tiene
      que llenar. casi toda expresion lo ignora;
      readInput y readEnv son la excepcion, porque
      lo que devuelven es texto hasta que algo dice
      que se suponia que era
    end note

    class DeclarationExecutor <<object>> implements StatementExecutor
    class AssignmentExecutor <<object>> implements StatementExecutor
    class CallExecutor implements StatementExecutor
    class IfExecutor <<object>> implements StatementExecutor

    class StatementExecutors <<object>> {
        +V1_0: List<StatementExecutor>
        +V1_1: List<StatementExecutor>
    }

    interface ValueFunction <<fun>> {
        +call(argument: Value, expected: Type?, span: Span, context): Result<Value>
    }

    class ValueFunctions <<object>> {
        +NONE: Map<String, ValueFunction>
        +readers(input, environment): Map<String, ValueFunction>
    }

    interface InputProvider <<fun>> {
        +read(): String?
    }
    class ConsoleInput <<object>> implements InputProvider
    class NoInput <<object>> implements InputProvider

    interface EnvironmentSource <<fun>> {
        +read(name: String): String?
    }
    class SystemEnvironment <<object>> implements EnvironmentSource

    ValueFunctions ..> ValueFunction : registro por nombre
    ValueFunctions --> InputProvider
    ValueFunctions --> EnvironmentSource

    note bottom of ValueFunctions
      readers es una fabrica y no una constante:
      readInput y readEnv necesitan colaboradores
      que recien existen cuando la corrida tiene
      de donde leer. el prompt sale por el mismo
      emitter que println: es salida, y el
      programa tiene una sola
    end note

    interface Builtin <<fun>> {
        +call(argument: Value, span: Span, context: ExecutionContext): Result<Unit>
    }

    class Builtins <<object>> {
        +V1_0: Map<String, Builtin>
        +V1_1: Map<String, Builtin>
    }

    note bottom of StatementExecutors
      el registro reemplaza al when exhaustivo:
      StatementExecutorsTest verifica que cubra
      todo el sealed hierarchy de Statement
    end note

    interface Value <<sealed>> {
        +type: Type
    }
    class NumberValue implements Value {
        +value: Double
    }
    class StringValue implements Value {
        +value: String
    }
    class BooleanValue implements Value {
        +value: Boolean
    }

    class ValueOps {
        +apply(op: BinaryOperator, left: Value, right: Value, span: Span): Result<Value>
    }

    interface OutputEmitter {
        +emit(line: String)
    }
    class ConsoleOutput implements OutputEmitter
    class CollectingOutput implements OutputEmitter {
        +lines(): List<String>
    }
}

' ------------------------------------------------------------
package checker {

    class Checker {
        -globalScope: Environment<Unit>
        -signatures: Map<String, Signature>
        -builtins: Set<String>
        +check(statement: Statement): Result<Unit>
    }

    class Signature {
        +argument: Type
    }

    class FunctionSignatures <<object>> {
        +NONE: Map<String, Signature>
        +V1_1: Map<String, Signature>
    }

    Checker o--> Signature
    FunctionSignatures ..> Signature : registro por nombre

    note bottom of Checker
      el gemelo del interprete a nivel de tipos:
      donde el interprete contesta QUE VALOR tiene
      una expresion, este contesta QUE TIPO, sin
      ejecutar nada. es lo que hace que validation
      valide semantica.
      despacha con un when exhaustivo y no con un
      registro, porque no varia por version: el
      parser de cada version ya decide que
      statements pueden existir.
      limite conocido: readInput y readEnv no se
      pueden validar del todo sin ejecutar
    end note
}

' ------------------------------------------------------------
package pipeline {

    interface TokenSource <<fun>> {
        +tokens(): Sequence<Result<Token>>
    }

    interface StatementParser <<fun>> {
        +parse(tokens: List<Token>): Result<Statement>
    }

    class StatementStream {
        -tokens: Iterator<Result<Token>>
        -parser: StatementParser
        -boundary: StatementBoundary
        -pending: Result<Token>?
        +hasNext(): Boolean
        +next(): Result<Statement>
    }

    interface StatementBoundary <<fun>> {
        +scan(): StatementScan
    }

    interface StatementScan {
        +take(token: Token): StatementScan
        +endsStatement(next: Token?): Boolean
    }

    class StatementBoundaries <<object>> {
        +V1_0: StatementBoundary
        +V1_1: StatementBoundary
    }

    StatementStream --> TokenSource
    StatementStream --> StatementParser
    StatementStream --> StatementBoundary
    StatementBoundary ..> StatementScan : es una fabrica

    note bottom of StatementBoundary
      donde termina un statement es lo unico de
      la gramatica que el pipeline no puede no
      saber: arma el lote ANTES de parsear.
      1.0: hasta el primer `;`.
      1.1: un `;` adentro de un bloque no corta,
      y el `}` exterior corta salvo que siga un
      `else` - de ahi el token de lookahead.
      StatementScan es un valor, no una maquina:
      take contesta con el scan que leyo un token
      mas, igual que el Cursor del formatter
    end note

    note bottom of TokenSource
      declaradas por el consumidor.
      pipeline no depende de lexer ni de parser
    end note
}

' ------------------------------------------------------------
package cli {

    enum Operation {
        VALIDATION
        EXECUTION
        FORMATTING
        ANALYZING
    }

    interface Program <<fun>> {
        +execute(statement: Statement): Result<Unit>
    }

    class Cli {
        -newStatements: (Path) -> StatementSource
        -newProgram: () -> Program
        -newChecker: () -> Program
        -newFormatting: (Path) -> Formatting
        -newAnalyzer: () -> Analyzer
        -renderer: ErrorRenderer
        -progress: ProgressPrinter
        +run(operation: Operation, file: Path): Result<Unit>
    }

    interface StatementSource <<AutoCloseable>> {
        +hasNext(): Boolean
        +next(): Result<Statement>
    }

    interface Formatting <<AutoCloseable>> {
        +format(): Result<Unit>
    }

    interface Analyzer <<fun>> {
        +findings(statement: Statement): List<String>
    }

    Cli --> Program
    Cli --> StatementSource
    Cli --> Formatting
    Cli --> Analyzer

    note bottom of Cli
      validation y execution son el MISMO
      recorrido con un Program distinto: uno
      chequea tipos, el otro ejecuta. Cli no sabe
      cual le toco
    end note

    class ProgressPrinter {
        -sink: Appendable
        +statementParsed(position: Position)
    }

}

' ------------------------------------------------------------
package app {

    class PrintScript <<composition root>> {
        -dialect: Dialect
        +cli(): Cli
    }

    class Dialect {
        +version: String
        +recognizers: List<TokenRecognizer>
        +syntaxes: List<StatementSyntax>
        +parselets: List<PrefixParselet>
        +executors: List<StatementExecutor>
        +boundary: StatementBoundary
        +signatures: Map<String, Signature>
        +functions: (InputProvider, EnvironmentSource) -> Map<String, ValueFunction>
        +of(version: String): Dialect?
    }

    PrintScript o--> Dialect

    note right of Dialect
      **una version del lenguaje son sus siete
      catalogos**, no un flag que alguien consulta.
      los strings "1.0" y "1.1" aparecen
      unicamente aca
    end note

    class PrintScriptCommand {
        +call(): Int
    }

    class Main {
        +main(args: Array<String>)
    }

    note bottom of PrintScript
      Pure DI: arma el grafo a mano y es el unico
      que nombra clases concretas. Lo que depende de
      un valor de runtime entra como factory:
      el stream (necesita el Reader, es de un solo uso)
      y el Program (estado vacio por corrida).
      Satisface TokenSource, StatementParser y Program
      con referencias a metodo, sin clases adaptadoras.
      PrintScriptCommand solo parsea argv y traduce
      codigos de salida; Main solo hace exitProcess.
    end note

    Main ..> PrintScriptCommand : delega argv
    PrintScriptCommand ..> PrintScript : construye
}

' ------------------------------------------------------------
' Relaciones entre paquetes
' ------------------------------------------------------------

Lexer *--> SourceReader
Lexer o--> TokenRecognizer
Lexer ..> Token : construye
TokenRecognizers ..> TokenRecognizer : lista por prioridad
Parser o--> StatementSyntax
Parser o--> PrefixParselet
StatementSyntaxes ..> StatementSyntax : lista por prioridad
PrefixParselets ..> PrefixParselet : lista por prioridad
ExpressionParser o--> PrefixParselet
ExpressionParser +-- ExpressionContext : lo implementa una inner class privada
StatementSyntax ..> ParsingContext : cursor y expresiones
StatementParser +-- ParsingContext : lo implementa una inner class privada
StatementParser o--> ExpressionParser
Interpreter o--> StatementExecutor
Interpreter o--> ValueFunction
Interpreter +-- ExecutionContext : lo implementa una inner class privada
StatementExecutors ..> StatementExecutor : lista
CallExecutor o--> Builtin
Builtins ..> Builtin : registro por nombre

Parser ..> Token : consume
Parser *--> TokenCursor
Parser ..> PrecedenceTable
Parser ..> NumberCodec : convierte literales
Parser ..> Statement : construye

IfStatement o--> Expression
IfStatement o--> Statement : dos bloques
FunctionCall o--> Expression

VariableDeclaration o--> Type
VariableDeclaration o--> Expression
Assignment o--> Expression
CallStatement o--> Expression
BinaryExpression o--> BinaryOperator

OperatorRules ..> Type

Lexer ..|> TokenSource : via Main
Parser ..|> StatementParser : via Main
Interpreter ..|> Program : via Main

Interpreter *--> Environment
Interpreter *--> ValueOps
Interpreter --> InputProvider : via ValueFunctions
Interpreter --> EnvironmentSource : via ValueFunctions

Checker *--> Environment
Checker ..> OperatorRules : la misma tabla que ValueOps
Checker ..> Statement : recorre sin ejecutar
Checker ..|> Program : via PrintScript
Interpreter --> OutputEmitter
Interpreter ..> Statement : ejecuta
ValueOps ..> OperatorRules
ValueOps ..> NumberCodec : imprime numeros

Cli ..> StatementStream : consume
Cli --> ErrorRenderer
Cli *--> ProgressPrinter

PrintScript ..> Cli : construye
PrintScript ..> Checker : construye
PrintScript ..> Lexer : construye
PrintScript ..> StatementStream : construye
PrintScript ..> Interpreter : construye
PrintScript ..> ConsoleOutput : construye
PrintScript ..> TokenSource : Lexer::tokens
PrintScript ..> StatementParser : Parser(dialect.syntaxes, dialect.parselets)::parse
PrintScript ..> StatementBoundary : dialect.boundary
PrintScript ..> Program : Interpreter::execute y Checker::check

Lexer ..> Result : devuelve
Parser ..> Result : devuelve
Interpreter ..> Result : devuelve
Result ..> Diagnostic
ErrorRenderer ..> Diagnostic : abre el ADT

@enduml
